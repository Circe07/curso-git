<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202124">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Ajustes de VideoLoop"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Número de pantallas" />

        <RadioGroup
            android:id="@+id/screens_group"
            style="@style/SettingsGroup">

            <RadioButton
                android:id="@+id/screens_1"
                style="@style/SettingsOption"
                android:text="1 pantalla" />

            <RadioButton
                android:id="@+id/screens_2"
                style="@style/SettingsOption"
                android:text="2 pantallas" />
        </RadioGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="Orientación" />

        <RadioGroup
            android:id="@+id/orientation_group"
            style="@style/SettingsGroup">

            <RadioButton
                android:id="@+id/orientation_horizontal"
                style="@style/SettingsOption"
                android:text="Horizontal" />

            <RadioButton
                android:id="@+id/orientation_vertical"
                style="@style/SettingsOption"
                android:text="Vertical" />
        </RadioGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="Ajuste del vídeo (siempre a pantalla completa)" />

        <RadioGroup
            android:id="@+id/fit_group"
            style="@style/SettingsGroup">

            <RadioButton
                android:id="@+id/fit_zoom"
                style="@style/SettingsOption"
                android:text="Rellenar (recorta bordes)" />

            <RadioButton
                android:id="@+id/fit_stretch"
                style="@style/SettingsOption"
                android:text="Estirar" />
        </RadioGroup>

        <TextView
            android:id="@+id/video_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="#BDC1C6"
            android:textSize="18sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="280dp"
            android:padding="16dp"
            android:text="Guardar y reproducir"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Para volver aquí: mantén pulsada la pantalla o pulsa OK / Menú en el mando."
            android:textColor="#9AA0A6"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
